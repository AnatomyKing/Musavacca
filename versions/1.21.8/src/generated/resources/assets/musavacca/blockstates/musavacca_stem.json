{
  "multipart": [
    {
      "apply": {
        "model": "musavacca:block/musavacca_stem"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/musavacca_stem",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/musavacca_stem",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    }
  ]
}