{
  "multipart": [
    {
      "apply": {
        "model": "musavacca:block/musavacca_pressure_plate"
      },
      "when": {
        "powered": "false"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/musavacca_pressure_plate_down"
      },
      "when": {
        "powered": "true"
      }
    }
  ]
}