{
  "multipart": [
    {
      "apply": [
        {
          "model": "musavacca:block/carotene_grass"
        },
        {
          "model": "musavacca:block/carotene_grass",
          "y": 90
        },
        {
          "model": "musavacca:block/carotene_grass",
          "y": 180
        },
        {
          "model": "musavacca:block/carotene_grass",
          "y": 270
        }
      ],
      "when": {
        "snowy": "false"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/carotene_grass_snowy"
      },
      "when": {
        "snowy": "true"
      }
    }
  ]
}