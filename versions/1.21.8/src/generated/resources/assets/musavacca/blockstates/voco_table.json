{
  "multipart": [
    {
      "apply": {
        "model": "musavacca:block/voco_mensa"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_lit_receptor"
      },
      "when": {
        "lit_north_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_lit_receptor",
        "y": 90
      },
      "when": {
        "lit_south_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_lit_receptor",
        "y": 180
      },
      "when": {
        "lit_south_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_lit_receptor",
        "y": 270
      },
      "when": {
        "lit_north_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_portal_north_east"
      },
      "when": {
        "portal_north_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_portal_south_east"
      },
      "when": {
        "portal_south_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_portal_south_west"
      },
      "when": {
        "portal_south_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_mensa_portal_north_west"
      },
      "when": {
        "portal_north_west": "true"
      }
    }
  ]
}