{
  "multipart": [
    {
      "apply": {
        "model": "musavacca:block/voco_table"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_lit_receptor_corner"
      },
      "when": {
        "lit_north_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_lit_receptor_corner",
        "y": 90
      },
      "when": {
        "lit_south_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_lit_receptor_corner",
        "y": 180
      },
      "when": {
        "lit_south_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_lit_receptor_corner",
        "y": 270
      },
      "when": {
        "lit_north_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_rotary_dialers"
      },
      "when": {
        "rotary_dialers": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_portal_north_east"
      },
      "when": {
        "portal_north_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_portal_south_east"
      },
      "when": {
        "portal_south_east": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_portal_south_west"
      },
      "when": {
        "portal_south_west": "true"
      }
    },
    {
      "apply": {
        "model": "musavacca:block/voco_table_portal_north_west"
      },
      "when": {
        "portal_north_west": "true"
      }
    }
  ]
}