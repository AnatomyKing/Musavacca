---
import ModelPreviewApp from '../components/ModelPreviewApp.jsx';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Model Preview</title>
</head>
<body>
<ModelPreviewApp client:load />
</body>
</html>

<style is:global>
    :root {
        color-scheme: dark;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
    }

    body {
        font-family: Inter, Arial, sans-serif;
        background: #0b1020;
        display: grid;
        place-items: center;
        padding: 24px;
    }

    #card {
        width: 700px;
        min-height: 700px;
        background: #151c30;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 20px;
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 14px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    }

    .meta h1 {
        margin: 0 0 8px;
        color: #f8fafc;
        font-size: 20px;
        word-break: break-word;
    }

    .meta p {
        margin: 0;
        color: #aab7d6;
        font-size: 13px;
        word-break: break-word;
    }

    .viewer {
        min-height: 580px;
        border-radius: 18px;
        background: #1d2742;
        display: grid;
        place-items: center;
    }

    .preview-image {
        width: 520px;
        height: auto;
        image-rendering: pixelated;
    }

    .empty {
        color: #f8fafc;
        text-align: center;
        display: grid;
        place-items: center;
        min-height: 620px;
    }
</style>